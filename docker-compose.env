# Copy this file to .env and fill in the values.
# .env is NOT committed to source control.
#
# This compose file pulls the pre-built image from Docker Hub
# (`docker compose up -d`) — no local checkout or build needed.

# Port the container's web UI is published on (host side)
APP_PORT=8090

# Timezone for the container (e.g. America/New_York)
TZ=UTC

# --- Pi-hole cluster ---
# All Pi-hole node IPs, comma-separated — the generated dnsmasq.d snippet
# and the etc_dnsmasq_d config flag get pushed to every one of these.
# Example: 192.168.1.101,192.168.1.102,192.168.1.103
PIHOLE_IPS=
# Pi-hole v6 web admin password (used to auth against each node's REST API)
PIHOLE_ADMIN_PASSWORD=

# --- SSH (used to write the dnsmasq.d file + trigger `pihole restartdns`) ---
# Doesn't have to be root — a non-root account works too, as long as it has
# passwordless sudo (required if root on your nodes only allows key-based
# login, since there's then no root password to bootstrap a key with).
# Every privileged remote command is run with `sudo` regardless of this
# setting (a no-op when SSH_USER is root).
PIHOLE_SSH_USER=root
# Path INSIDE the container the key should live at. Defaults to the /data volume
# so a key created via the in-app "Setup" tab persists across container recreates
# without needing anything in .env at all. Only override if bind-mounting a key
# file in from elsewhere.
PIHOLE_SSH_KEY=/data/ssh/pihole_key
# Portable option: base64 of an existing private key file (`base64 -w0 keyfile`),
# decoded to PIHOLE_SSH_KEY on first startup if nothing is there yet. Use this for
# a clean install where you already have a key you want to reuse. Leave blank to
# generate a fresh key from the Setup tab instead — the Setup tab writes the
# generated key's PIHOLE_SSH_KEY_B64 back into this file automatically, so it's
# backed up here too, not just sitting in the /data volume.
PIHOLE_SSH_KEY_B64=
# Optional filename for the generated conf, dropped in /etc/dnsmasq.d/ on each node
DNSMASQ_CONF_NAME=10-vlans.conf

# --- Software auto-updater ---
# UTC hour the daily round-robin `pihole -up` fires (one node per day)
PIHOLE_UPDATER_HOUR=3
# Retries per upgrade attempt before marking it failed
UPGRADE_RETRIES=3
# How often (seconds) to refresh version info for display, outside of upgrades
UPDATER_VERSION_POLL_SECS=3600

# --- DHCP failover ---
# The keepalived VIP already in front of the Pi-hole cluster for DNS
# (e.g. 192.168.1.100). DHCP is broadcast-based, so the VIP does nothing to
# stop every node's embedded DHCP server from independently answering every
# request — required for the Failover tab to know which physical node is
# the current VRRP master and should be the only one with DHCP active.
# Leave blank to disable DHCP failover management entirely.
PIHOLE_VIP=
# How often (seconds) to re-check the VIP master and re-assert DHCP state
DHCP_FAILOVER_CHECK_INTERVAL_SECS=15

# --- Staggered gravity (blocklist) updates ---
# UTC hour the daily round-robin gravity update fires (one node per day).
# Deliberately offset from PIHOLE_UPDATER_HOUR so the two schedules don't collide.
GRAVITY_UPDATE_HOUR=4
# If a node's blocklist domain count drops by more than this percent after an
# update, it's flagged as a probable partial-update failure (e.g. a blocklist
# URL that was briefly unreachable) rather than assumed to be intentional.
GRAVITY_DROP_THRESHOLD_PERCENT=10

# --- External DHCP-source sync (optional) ---
# For setups where Pi-hole handles DNS only and DHCP is served by a different
# platform — Pi-hole never sees a lease in that topology, so every client shows
# up as "Unknown". Set to "unifi" to pull the client name/MAC/IP list from a
# UniFi OS controller and publish it as local DNS records on every node. Leave
# blank to disable entirely (default — inert either way unless set).
# NOTE: only UniFi OS (UDM-family) is implemented, and it hasn't been verified
# against real UniFi hardware yet — treat as best-effort.
EXTERNAL_DHCP_SOURCE=
# How often (seconds) to re-poll the external source and re-sync
EXTERNAL_DHCP_POLL_SECS=300
# UniFi OS controller hostname/IP (no scheme/port — e.g. 192.168.1.1)
UNIFI_HOST=
UNIFI_USER=
UNIFI_PASSWORD=
# UniFi site name (default site is literally named "default")
UNIFI_SITE=default

# --- Node health monitoring (Health tab) ---
# Three-layer check per node (ping -> DNS -> Pi-hole API), how often (seconds)
MONITOR_CHECK_INTERVAL=60
# Domains to test DNS resolution against — passes if any one resolves
MONITOR_DOMAINS=google.com,cloudflare.com
# DNS check retries before marking a node's DNS as failed
MONITOR_DNS_RETRIES=3
# Before a node is ever reported/shown as down, a probe must fail this many
# times in a row (spaced MONITOR_CONFIRM_INTERVAL_SECS apart) — avoids a
# single transient blip (e.g. a node briefly under load) flipping its status.
# A healthy probe returns immediately either way; this only adds delay while
# a node is actually failing.
MONITOR_CONFIRM_ATTEMPTS=3
MONITOR_CONFIRM_INTERVAL_SECS=45
# Consecutive failures before the first SSH reboot is attempted
MONITOR_REBOOT_AFTER=3
# Extra SSH reboot attempts if the node is still down, spaced by the interval below
MONITOR_REBOOT_RETRIES=2
# Minutes to wait between SSH reboot retries. After MONITOR_REBOOT_RETRIES
# attempts are exhausted, the node is left down and flagged — no further
# automated action is taken.
MONITOR_REBOOT_AFTER_MINUTES=10
# How often (seconds) to refresh each node's uptime and re-detect the VIP master
MONITOR_UPTIME_INTERVAL=300

# --- Admin login (Setup tab) ---
# Off by default — set via the Setup tab's "Admin Login" switch, which writes the
# password back here automatically. Only set this by hand if you're pre-seeding a
# fresh deploy; leave blank otherwise.
ADMIN_PASSWORD=

# --- Notifications ---
# Generic webhook URL — POSTs {event, message, severity, source} JSON on node-down,
# gravity partial-failure, upgrade failure, and drift-check findings. Works with
# Home Assistant's REST API, ntfy, a Telegram bridge, n8n, or anything else that
# takes a webhook. Leave blank to disable.
NOTIFY_WEBHOOK_URL=

# --- Software updater: post-upgrade health gate ---
# Seconds to wait after a `pihole -up` + reboot before running a health check
# against the node — a bad release must not silently roll on to the next node
# the following day, so a failed check halts the daily rotation until manually
# resumed from the Updater tab.
UPDATER_POST_UPGRADE_WAIT_SECS=90

# --- NetBox import (Setup tab) ---
# Read-only: imports VLANs (via their associated Prefix) and static host
# reservations (via IP Addresses assigned to a device/VM interface with a MAC)
# from NetBox's IPAM+DCIM. Leave NETBOX_URL blank to disable entirely.
NETBOX_URL=
NETBOX_TOKEN=
# Set to true only if NetBox has a valid (non-self-signed) TLS cert
NETBOX_VERIFY_SSL=false
